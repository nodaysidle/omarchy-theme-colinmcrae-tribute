#!/bin/bash
#
# Colin McRae Tribute — Omarchy Theme Hook
# Installed to ~/.config/omarchy/hooks/theme-set.d/colinmcrae-tribute
#
# Applies/reverts the GTK glass shims. Omarchy loads the theme's hyprland.lua
# and foot.ini itself, so the hook no longer touches Hyprland or terminals.

set -euo pipefail

THEME="${1:-}"
HYPRLAND="$HOME/.config/hypr/hyprland.lua"

THEME_DIR="$HOME/.config/omarchy/themes/colinmcrae-tribute"
if [[ ! -d "$THEME_DIR" && -d "$HOME/dev/nodaysidle/omarchy-theme-colinmcrae-tribute" ]]; then
  THEME_DIR="$HOME/dev/nodaysidle/omarchy-theme-colinmcrae-tribute"
fi

GTK4_CSS="$HOME/.config/gtk-4.0/gtk.css"
GTK3_CSS="$HOME/.config/gtk-3.0/gtk.css"
SHIM4='@import url("../omarchy/current/theme/gtk.css");'
SHIM3='@import url("../omarchy/current/theme/gtk3.css");'

add_import() {
  local file=$1 line=$2 tmp
  mkdir -p "$(dirname "$file")"

  if [[ ! -f $file ]]; then
    printf '%s\n' "$line" >"$file"
    return 0
  fi

  grep -qxF "$line" "$file" && return 0

  tmp="$file.colinmcrae-tribute.$$"
  { printf '%s\n' "$line"; cat "$file"; } >"$tmp"
  mv "$tmp" "$file"
}

remove_import() {
  local file=$1 line=$2 tmp
  [[ -f $file ]] || return 0
  grep -qxF "$line" "$file" || return 0

  tmp="$file.colinmcrae-tribute.$$"
  grep -vxF "$line" "$file" >"$tmp" || true
  if [[ -s $tmp ]]; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp" "$file"
  fi
}

apply_assets() {
  [[ -d $THEME_DIR ]] || return 0
  add_import "$GTK4_CSS" "$SHIM4"
  [[ -f $THEME_DIR/gtk3.css ]] && add_import "$GTK3_CSS" "$SHIM3"
}

revert_assets() {
  remove_import "$GTK4_CSS" "$SHIM4"
  remove_import "$GTK3_CSS" "$SHIM3"
}

# Older versions of this hook appended a dofile() block to hyprland.lua, which
# made the theme load twice. Strip it if it is still there.
HYPRLAND_MARK_BEGIN='-- >>> colinmcrae-tribute >>>'
HYPRLAND_MARK_END='-- <<< colinmcrae-tribute <<<'

remove_legacy_hyprland_block() {
  [[ -f $HYPRLAND ]] || return 0
  grep -qxF -- "$HYPRLAND_MARK_BEGIN" "$HYPRLAND" || return 0

  local tmp="$HYPRLAND.colinmcrae-tribute.$$"
  awk -v begin="$HYPRLAND_MARK_BEGIN" -v end="$HYPRLAND_MARK_END" '
    $0 == begin { skipping = 1; next }
    $0 == end   { skipping = 0; next }
    !skipping   { print }
  ' "$HYPRLAND" >"$tmp"
  mv "$tmp" "$HYPRLAND"
}

remove_legacy_hyprland_block

if [[ $THEME == "colinmcrae-tribute" || $THEME == "colin-mcrae-tribute" ]]; then
  apply_assets
else
  revert_assets
fi
